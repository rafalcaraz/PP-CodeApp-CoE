{
  "name": "vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e:auth": "playwright test --headed --project=setup",
    "e2e": "playwright test --project=smoke-anon --project=smoke",
    "e2e:anon": "playwright test --project=smoke-anon",
    "e2e:visual": "playwright test --project=visual",
    "e2e:update-snapshots": "playwright test --project=visual --update-snapshots",
    "e2e:report": "playwright show-report",
    "capture:fixtures": "node scripts/capture-fixtures.mjs",
    "screenshots": "node scripts/update-readme-screenshots.mjs",
    "postinstall": "node ../scripts/fixup-generated-connectors.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fluentui/react-components": "^9.73.8",
    "@fluentui/react-icons": "^2.0.327",
    "@microsoft/power-apps": "^1.1.3",
    "fflate": "^0.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@microsoft/power-apps-vite": "^1.0.2",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-boundaries": "5.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "25.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "2.1.9"
  }
}
